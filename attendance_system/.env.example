# ── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-substitua-por-chave-segura-em-producao
DEBUG=True
ALLOWED_HOSTS=*,localhost,127.0.0.1

# ── Banco de dados (PostgreSQL) ───────────────────────────────────────────────
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=4790
DB_HOST=localhost        # Em Docker: nome do serviço (db)
DB_PORT=5432

# ── Redis — cache, sessões e result backend Celery ────────────────────────────
REDIS_URL=redis://localhost:6380/0
# Em Docker: redis://redis:6379/0

# ── RabbitMQ — broker de mensagens Celery ────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Em Docker: amqp://guest:guest@rabbitmq:5672/

# ── Sistema ───────────────────────────────────────────────────────────────────
SYSTEM_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# ── Rede universitária — IPs/CIDRs separados por vírgula ─────────────────────
# Produção: colocar ranges reais da UFVJM
# Desenvolvimento/teste: 0.0.0.0/0 aceita qualquer IP
UNIVERSITY_IP_RANGES=177.74.237.209,127.0.0.1,10.0.0.0/8,192.168.0.0/16,200.131.0.0/16

# ── Microserviços — identificação do serviço (usada em logs e métricas) ───────
# Valores: auth-service | courses-service | attendance-service | reports-service
SERVICE_NAME=monolith

# ── Segurança (produção) ──────────────────────────────────────────────────────
# Descomente e configure ao fazer deploy em HTTPS
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.com
